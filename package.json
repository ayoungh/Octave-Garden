{
  "name": "octave-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5184 --strictPort",
    "build": "tsc -b && vite build",
    "start": "vite preview --host localhost --port 5184 --strictPort",
    "test": "vitest run",
    "notices": "node scripts/generate-notices.mjs",
    "prebuild": "npm run notices",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "description": "A local piano-learning studio with beginner lessons, songs and MIDI keyboard support.",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
